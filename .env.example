# Copy to .env and adjust. Only APP_ENCRYPTION_KEY is required.
#
#   cp .env.example .env
#   openssl rand -base64 48      # paste the output into APP_ENCRYPTION_KEY below

# ==== Security =====================================================================

# REQUIRED. Encrypts every user's Immich API key at rest (AES-256-GCM, key derived with HKDF).
# At least 32 characters. Generate:  openssl rand -base64 48
# Back it up with your data: if it changes, saved Immich keys can't be decrypted and each person
# has to paste their key again (accounts, cards and exports are unaffected).
APP_ENCRYPTION_KEY=

# Optional. Separate HMAC key for session tokens (32+ characters). When empty it is derived from
# APP_ENCRYPTION_KEY. Changing it signs everyone out.
SESSION_SECRET=

# Anyone who can reach HomeCard may create an account when true. Default false: invite-only —
# admins add household members under Settings → Users.
ALLOW_REGISTRATION=false

# Behind a reverse proxy (Nginx Proxy Manager, SWAG, Traefik, Caddy…)? Tell HomeCard which proxy
# to trust for X-Forwarded-For / X-Forwarded-Proto (used for login rate limiting, the audit log
# and Secure cookies). Values: empty/false (direct access, default), true (trust any), a hop count
# like 1, or a comma-separated list of proxy IPs/CIDRs such as 172.18.0.0/16.
TRUST_PROXY=

# true = always send Secure cookies and HSTS. Set it when HomeCard is ONLY reached over HTTPS.
# (With TRUST_PROXY set, cookies are also marked Secure whenever the proxy reports https.)
HTTPS=false

# Sessions end after this many days without use, and after SESSION_MAX_DAYS regardless.
SESSION_IDLE_DAYS=14
SESSION_MAX_DAYS=60

# ==== Immich (optional) ============================================================

# Server address as reachable FROM the container, without /api. Example: http://192.168.1.20:2283
# Only the admin sets this (here, or in the app under Settings → Server). There is no shared API
# key: each person links their own READ-ONLY key under Settings → Immich connection.
IMMICH_URL=

# ==== Stock backgrounds (optional) =================================================

# Easiest: leave these empty and manage them in the app (Settings → Server), where keys are
# checked with the provider and stored encrypted. A value here wins and locks that setting.
# Pixabay (recommended): free key at https://pixabay.com/api/docs/  — illustrations, vectors, photos.
PIXABAY_API_KEY=
# Unsplash: create an app at https://unsplash.com/developers and use its Access Key.
UNSPLASH_API_KEY=
# Openverse: keyless public-domain / CC0 images, on by default. false = a server that never goes online.
OPENVERSE_ENABLED=

# ==== Host side (docker compose and docker/unraid.sh; not passed to the container) ===

# Port on the host that serves the web UI.
HOMECARD_PORT=8787
# Where HomeCard keeps its data on the host (Unraid: /mnt/user/appdata/homecard).
HOMECARD_DATA=./homecard-data
# Your existing photo folder (mounted read-only at /data/photos). Inside it, use
#   shared/            photos everyone in the household may use
#   users/<username>/  photos only that person can see
PHOTOS_PATH=./homecard-data/photos
# docker/unraid.sh update only: copy the source from this folder before building, e.g. a
# Nextcloud/Syncthing-synced copy. Everything in the build folder except .env and homecard-data/
# is replaced by the copy.
# HOMECARD_SOURCE=/mnt/user/documents/nextcloud/<you>/files/Projects/HomeCard

# ==== Container user ===============================================================

# Files are written as this user/group. Unraid default: 99 (nobody) / 100 (users).
PUID=99
PGID=100
# 027 = new files are readable by the owner and group only.
UMASK=027
TZ=Etc/UTC

# ==== Tuning =======================================================================

# Parallel print renders. Each 300 DPI render uses roughly 300–600 MB of RAM.
RENDER_CONCURRENCY=2
# Max size of the derived-image cache (thumbnails, previews, converted HEIC/RAW originals).
CACHE_MAX_MB=4096
# Upload size limit per photo (MB).
MAX_UPLOAD_MB=200
# Folder watching for /data/fonts, /data/styles, /data/photos. Use polling on SMB/NFS mounts.
WATCH=true
WATCH_POLLING=false
LOG_LEVEL=info

# ==== Removed in 1.1 ===============================================================
# IMMICH_API_KEY (one shared key)  → each user links their own read-only key in the app.
# AUTH_USERNAME / AUTH_PASSWORD     → replaced by real accounts (first start: create the admin).
