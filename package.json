{
  "name": "homecard",
  "version": "0.13.1",
  "license": "MIT",
  "private": true,
  "description": "HomeCard — self-hosted, print-ready holiday & occasion card studio with Immich integration.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "assets": "node --import tsx scripts/collect-fonts.mjs && node scripts/collect-vendor.mjs",
    "textures": "node scripts/generate-textures.mjs",
    "layouts:mega": "node --import tsx scripts/generate-mega-layouts.mjs",
    "dev": "npm run assets && concurrently -k -n server,web -c blue,green \"npm run dev -w @homecard/server\" \"npm run dev -w @homecard/web\"",
    "build": "npm run assets && npm run build -w @homecard/web && npm run build -w @homecard/server",
    "start": "npm run start -w @homecard/server",
    "typecheck": "tsc -p packages/shared --noEmit && tsc -p apps/server --noEmit && tsc -p apps/web --noEmit",
    "test": "node --import tsx --test packages/shared/test/*.test.ts apps/server/test/*.test.ts"
  },
  "engines": {
    "node": ">=24.7"
  },
  "devDependencies": {
    "@fontsource/abril-fatface": "^5.3.0",
    "@fontsource/amatic-sc": "^5.3.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/dancing-script": "^5.3.0",
    "@fontsource/dm-serif-display": "^5.3.0",
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/great-vibes": "^5.3.0",
    "@fontsource/josefin-sans": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/mountains-of-christmas": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/parisienne": "^5.3.0",
    "@fontsource/pinyon-script": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/raleway": "^5.3.0",
    "@fontsource/sacramento": "^5.3.0",
    "@fontsource/work-sans": "^5.3.0",
    "@types/node": "^26.6.6",
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
