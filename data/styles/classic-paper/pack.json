        "family": "Cormorant Garamond",
        "weight": 600,
        "style": "italic"
      },
      "body": {
        "family": "EB Garamond",
        "weight": 400,
        "style": "normal"
      },
      "accent": {
        "family": "Work Sans",
        "weight": 500,
        "style": "normal",
        "letterSpacing": 0.24,
        "transform": "uppercase"
      }
    }
